\deqn{Q^{(k)}_i[v,w] = Q^{(k-1)}_i[v,w] - \rho_k Q^{(k-1)}_{k-i}[v,w]
  - v_k T^{(k-1)}_{k-i}[w] - w_k T^{(k-1)}_{k-i}[v]
  - e_k\big(T^{(k-1)}_{k-i}[v]w\big)^{\!\top}
  - \big(T^{(k-1)}_{k-i}[v]w\big)e_k^{\top}.}

