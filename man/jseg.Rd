\eqn{g(\theta_i) = \eta_i} in which the rest of the equation supplies
\eqn{z_i'\alpha},

\deqn{\eta_i = z_i'\alpha + \beta x_i + \sum_{k=1}^{K}
  \bigl[\delta_k\,\mathbb{1}(x_i \geq \psi_k)
        + \gamma_k\,(x_i - \psi_k)_{+}\bigr].}

